# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM (question generation, short-answer grading, and grounded chat) ---
# Tested with Groq's OpenAI-compatible API:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
# The Groq SDK appends /openai/v1 itself, so either the host
# (https://api.groq.com) or the full path above is accepted.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_COMPLETION_TOKENS=2048
LLM_REASONING_EFFORT=medium

# --- Embeddings (local only in v1) ---
EMBEDDING_PROVIDER=local
# BGE-M3 is a strong multilingual retriever (1024-dim, 8k-token context).
# It is larger than MiniLM: the first run downloads the model and the first
# search loads it into memory. Set EMBEDDING_DEVICE=cuda if you have a GPU.
EMBEDDING_MODEL=BAAI/bge-m3
# Optional: "cpu" or "cuda". Leave blank for auto-detect.
EMBEDDING_DEVICE=
# Smaller batches use less RAM; raise this on a GPU or a large-RAM machine.
EMBEDDING_BATCH_SIZE=8
# BGE-M3 supports 8k tokens. 1024 leaves headroom over 512-token chunks.
EMBEDDING_MAX_SEQ_LENGTH=1024

# --- Storage ---
CHROMA_DIR=data/chroma
# BGE-M3 vectors are not compatible with an all-MiniLM index, so use a new
# collection and re-index your resources after changing the embedding model.
CHROMA_COLLECTION=studymate_bge_m3
SQLITE_PATH=data/studymate.db

# --- Chunking ---
# Sentence/paragraph-aware chunking packs up to this many tokens per chunk and
# repeats up to CHUNK_OVERLAP_TOKENS tokens of context between neighbours.
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=96

# --- Retrieval / generation limits ---
RETRIEVAL_TOP_K=10
MAX_CONTEXT_TOKENS=6000
MAX_QUESTIONS=30
DEFAULT_QUESTION_COUNT=10

# --- Uploads ---
MAX_PDFS=5

# --- Logging ---
LOG_LEVEL=INFO
